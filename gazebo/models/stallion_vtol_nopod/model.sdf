      <area>0.038</area><air_density>1.2041</air_density>
      <cp>0.0080 -0.2300 0.0250</cp><forward>1.0000 0.0000 0.0000</forward><upward>0.0000 0.0000 1.0000</upward>
      <link_name>base_link</link_name>
    </plugin>
    <!-- Wing outboard panel right + aileron -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.063</a0><cla>4.3</cla><cda>0.13</cda><cma>0.0</cma>
      <alpha_stall>0.19</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.0605</area><air_density>1.2041</air_density>
      <cp>-0.0040 -0.4700 0.0280</cp><forward>1.0000 0.0000 0.0000</forward><upward>0.0000 0.0000 1.0000</upward>
      <link_name>base_link</link_name>
      <control_joint_name>aileron_right_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.6</control_joint_rad_to_cl>
    </plugin>
    <!-- V-tail panel left + ruddervator -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>3.0</cla><cda>0.1</cda><cma>0.0</cma>
      <alpha_stall>0.3</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.0322</area><air_density>1.2041</air_density>
      <cp>-0.5500 0.1150 0.0850</cp><forward>1.0000 0.0000 0.0000</forward><upward>0.0000 -0.5736 0.8192</upward>
      <link_name>base_link</link_name>
      <control_joint_name>ruddervator_left_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.5</control_joint_rad_to_cl>
    </plugin>
    <!-- V-tail panel right + ruddervator -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>3.0</cla><cda>0.1</cda><cma>0.0</cma>
      <alpha_stall>0.3</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.0322</area><air_density>1.2041</air_density>
      <cp>-0.5500 -0.1150 0.0850</cp><forward>1.0000 0.0000 0.0000</forward><upward>0.0000 0.5736 0.8192</upward>
      <link_name>base_link</link_name>
      <control_joint_name>ruddervator_right_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.5</control_joint_rad_to_cl>
    </plugin>
    <!-- Parasite drag: frontal area 5.4 dm2 x Cd 0.20 (no lift) -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>1.0</a0><cla>0.0</cla><cda>0.2</cda><cma>0.0</cma>
      <alpha_stall>10.0</alpha_stall><cla_stall>0.0</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.054</area><air_density>1.2041</air_density>
      <cp>0.0000 0.0000 0.0000</cp><forward>1.0000 0.0000 0.0000</forward><upward>0.0000 0.0000 1.0000</upward>
      <link_name>base_link</link_name>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 0</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>
      <!-- ch0 SERVO1 Motor1 front-right (CCW) / ch1 SERVO2 Motor2 front-left (CW) / ch2 SERVO3 Motor4 rear (CCW) -->
      <control channel="0">
        <jointName>fr_motor_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1610</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="1">
        <jointName>fl_motor_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-1610</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="2">
        <jointName>rear_motor_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1610</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- ch3 SERVO4 tilt: 1000 = up (hover), 2000 = forward -->
      <control channel="3">
        <jointName>fl_tilt_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.5708</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>10.0</cmd_max><cmd_min>-10.0</cmd_min>
      </control>
      <control channel="3">
        <jointName>fr_tilt_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.5708</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>10.0</cmd_max><cmd_min>-10.0</cmd_min>
      </control>
      <!-- ch4 SERVO5 rear yaw servo -->
      <control channel="4">
        <jointName>rear_yaw_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-0.524</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0.5</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>10.0</cmd_max><cmd_min>-10.0</cmd_min>
      </control>
      <!-- ch5 SERVO6 ailerons: roll right = left TE down, right TE up -->
      <control channel="5">
        <jointName>aileron_left_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-0.7</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>2.0</p_gain><i_gain>0</i_gain><d_gain>0.02</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
      </control>
      <control channel="5">
        <jointName>aileron_right_joint</jointName>
        <useForce>1</useForce>
        <multiplier>0.7</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>2.0</p_gain><i_gain>0</i_gain><d_gain>0.02</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
      </control>
      <!-- ch6 SERVO7 V-tail left (79), ch7 SERVO8 V-tail right (80): PWM up = TE up -->
      <control channel="6">
        <jointName>ruddervator_left_joint</jointName>
        <useForce>1</useForce>
        <multiplier>0.7</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>2.0</p_gain><i_gain>0</i_gain><d_gain>0.02</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
      </control>
      <control channel="7">
        <jointName>ruddervator_right_joint</jointName>
        <useForce>1</useForce>
        <multiplier>0.7</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>2.0</p_gain><i_gain>0</i_gain><d_gain>0.02</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
      </control>
    </plugin>
  </model>
</sdf>
